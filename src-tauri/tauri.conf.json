{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Distributed MAS Client",
  "version": "0.1.0",
  "identifier": "dev.distributedmas.client",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "npm run dev -- --port 3001",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "transparent": true,
        "windowEffects": {
          "effects": [
            "hudWindow"
          ]
        },
        "trafficLightPosition": {
          "x": 20.0,
          "y": 32.0
        }
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
